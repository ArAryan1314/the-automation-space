# Copy this file to .env.local and fill in values. Only the admin login is required,
# and only for /admin-login to work.
# .env.local is git-ignored; this example file is committed.

# Admin login (server-only). Do not type these by hand: "pnpm admin:create" writes them.
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=

# Folder for stored jobs, contacts, applications, intakes and candidate accounts (server-only). Default: .data
# In production, use a folder outside the app, so uploading a new version cannot touch stored data.
DATA_DIR=

# Outgoing email (server-only). When SMTP_HOST is empty, no emails are sent: use the console's
# Pending candidates tab, and its Password reset link button instead of the emailed link.
SMTP_HOST=
# 465 uses TLS from the start; other ports upgrade to TLS when the server offers it. Default: 587
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Sender address. Default: SMTP_USER
SMTP_FROM=
# Who is told about new account requests. Default: ADMIN_USERNAME, when that is an email address
ADMIN_NOTIFY_EMAIL=

# Public site URL, used for canonical links and Open Graph URLs.
# Inlined at build time, so rebuild after changing it.
NEXT_PUBLIC_SITE_URL=https://the-automation-space.com

# Google Gemini API key (server-only). When set, /api/ai-respond drafts a personalised
# acknowledgement for each intake; when empty, a standard template reply is used.
GEMINI_API_KEY=

# Gemini model used for drafting (server-only).
GEMINI_MODEL=gemini-2.5-flash
