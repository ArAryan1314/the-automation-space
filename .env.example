# Copy this file to .env.local and fill in values. All variables are optional.
# .env.local is git-ignored; this example file is committed.

# Public site URL, used for canonical links and Open Graph URLs.
# Inlined at build time, so rebuild after changing it.
NEXT_PUBLIC_SITE_URL=https://the-automation-space.com

# Google Gemini API key (server-only). When set, /api/ai-respond drafts a personalised
# acknowledgement for each intake; when empty, a standard template reply is used.
GEMINI_API_KEY=

# Gemini model used for drafting (server-only).
GEMINI_MODEL=gemini-2.5-flash
